# Shuffle affiliate wager endpoint — the UUID in the path is the credential.
SHUFFLE_WAGER_URL=
# Month-start snapshot, from `node scripts/shuffle-baseline.mjs`. Without it the
# Shuffle board shows cumulative totals instead of this period. Update monthly.
SHUFFLE_BASELINE=

# Lootbox Partner Data API. The base URL is issued with the key.
LOOTBOX_API_URL=https://partners.lootbox.com
LOOTBOX_API_KEY=

# Canonical origin, e.g. https://misfitmason.com. Optional on Vercel, which
# supplies VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=
