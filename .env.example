# Roobet affiliate stats. The whole JWT is the credential; the affiliate id
# is read from its own `id` claim, so there is nothing else to configure.
ROOBET_API_TOKEN=

# Canonical origin, e.g. https://misfitmason.com. Optional on Vercel, which
# supplies VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=

# Discord webhook for affiliate-revenue claims. Server-side only.
DISCORD_CLAIM_WEBHOOK_URL=

# Any long random string; signs the 24h claim cooldown cookie.
CLAIM_SECRET=

# Discord OAuth app for claim sign-in. Register the callback as
# <origin>/api/auth/discord/callback for every origin the site runs on.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Lootbox Partner Data API. The base URL is issued with the key.
LOOTBOX_API_URL=https://partners.lootbox.com
LOOTBOX_API_KEY=
